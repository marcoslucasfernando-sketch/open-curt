# Copia este archivo como .env (iniciar.command lo hace solo). No lo compartas.
# También se puede rellenar desde la app: Ajustes → IA y Ajustes → YouTube.

# --- IA (GPT-6 Luna) ---------------------------------------------------------
# Opcional si conectas tu cuenta de ChatGPT (OAuth) desde Ajustes → IA.
OPENAI_API_KEY=

# --- YouTube: ID de cliente y secreto de Google Cloud (cliente «Aplicación de escritorio»)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Avanzado ------------------------------------------------------------------
# CORTACLIPS_PORT=8766
