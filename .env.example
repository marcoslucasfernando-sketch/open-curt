# Copia este archivo como .env (iniciar.command lo hace solo). No lo compartas.
# Todo esto también se puede rellenar desde la app: Ajustes → IA / Redes.

# --- IA (GPT-6 Luna) ---------------------------------------------------------
# Opcional si conectas tu cuenta de ChatGPT (OAuth) desde Ajustes → IA.
OPENAI_API_KEY=

# --- YouTube (Google Cloud → ID de cliente OAuth tipo «App de escritorio») ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- TikTok (developers.tiktok.com → Login Kit Desktop + Content Posting API) -
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Instagram (developers.facebook.com → Instagram API con inicio de sesión de Instagram)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Página HTTPS que devuelve el código a tu Mac (Instagram no acepta http://127.0.0.1).
OAUTH_HTTPS_REDIRECT=

# --- Alternativa de pago sin apps de desarrollador ---------------------------
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# --- Avanzado ------------------------------------------------------------------
# CORTACLIPS_PORT=8766
# INSTAGRAM_API_VERSION=v26.0
